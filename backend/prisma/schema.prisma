generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String   @id @default(uuid())
  username    String   @unique
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  pairCode    String   @unique @map("pair_code")
  fcmToken    String?  @map("fcm_token")
  partnerId   String?  @map("partner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  partner       Profile?       @relation("CouplePair", fields: [partnerId], references: [id])
  pairedBy      Profile[]      @relation("CouplePair")
  widgetUpdates WidgetUpdate[]

  @@map("profiles")
}

model WidgetUpdate {
  id           String   @id @default(uuid())
  senderId     String   @map("sender_id")
  imageUrl     String   @map("image_url")
  caption      String?
  locationName String?  @map("location_name")
  createdAt    DateTime @default(now()) @map("created_at")

  sender Profile @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("widget_updates")
}
