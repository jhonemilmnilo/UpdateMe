<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Partner Moment Image (scaleType fitCenter to show 100% full height from top to bottom) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="Partner Moment Photo" />

    <!-- Fallback / Empty State Placeholder Container -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATEME"
            android:textColor="#E8ECE9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Waiting for moments..."
            android:textColor="#8E9A8E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Top Metadata Header: Location Badge Only -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_location_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:text="TODAY"
            android:textColor="#E8ECE9"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Bottom Scrim & Caption + Time + React Action Overlay -->
    <RelativeLayout
        android:id="@+id/widget_bottom_overlay"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_scrim_bg"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <!-- Heart React Button (Right aligned at bottom) -->
        <ImageButton
            android:id="@+id/widget_react_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/widget_react_bg"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_outline"
            android:contentDescription="Heart React Button" />

        <!-- Vertical Container for Caption & Time on Left -->
        <LinearLayout
            android:id="@+id/widget_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@id/widget_react_btn"
            android:layout_toLeftOf="@id/widget_react_btn"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <!-- Caption -->
            <TextView
                android:id="@+id/widget_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E8ECE9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Time below caption -->
            <TextView
                android:id="@+id/widget_time_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="--:--"
                android:textColor="#8E9A8E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
